{
  "schema": "raise-v1/live_claims/1",
  "why": "Numbers that describe the CURRENT state of the instrument rather than a past measurement. These go stale silently: the value stays banked in some artifact forever, so tools/claimcheck.py keeps passing it long after it stopped being true. tools/freshness.py re-derives each one and fails on divergence. A past measurement does NOT belong here - a 2026-08-25 accuracy is supposed to stay what it was.",
  "claims": [
    {
      "id": "mutations-run",
      "file": "VERDICT.md",
      "pattern": "\\| Every gate can be shown to fail \\| (\\d+) mutations, (\\d+) detected, (\\d+) survived \\|",
      "artifact": "artifacts/verification/mutation_report.json",
      "select": [
        "total_mutations",
        "detected",
        "survived"
      ]
    },
    {
      "id": "prereg-chain",
      "file": "VERDICT.md",
      "pattern": "\\| Preregistration chain verifies, reader unchanged since freeze \\| (\\d+) entries, head `([0-9a-f]{8})",
      "artifact": "artifacts/verification/prereg_status.json",
      "select": [
        "chain|len",
        "chain.-1.hash|head8"
      ]
    },
    {
      "id": "coverage-weakest-row",
      "file": "VERDICT.md",
      "pattern": "\\*\\*(\\d+) of (\\d+) claims are in `neither`",
      "artifact": "artifacts/verification/coverage.json",
      "select": [
        "claims|count:class=neither",
        "claims|len"
      ]
    },
    {
      "id": "coverage-neither",
      "file": "VERDICT.md",
      "pattern": "\\| `neither` \\| \\*\\*(\\d+)\\*\\* \\|",
      "artifact": "artifacts/verification/coverage.json",
      "select": [
        "claims|count:class=neither"
      ]
    },
    {
      "id": "coverage-arithmetic",
      "file": "VERDICT.md",
      "pattern": "\\| `arithmetic-verifiable` \\| (\\d+) \\|",
      "artifact": "artifacts/verification/coverage.json",
      "select": [
        "claims|count:class=arithmetic-verifiable"
      ]
    },
    {
      "id": "coverage-primary",
      "file": "VERDICT.md",
      "pattern": "\\| `primary-verifiable` \\| (\\d+) \\|",
      "artifact": "artifacts/verification/coverage.json",
      "select": [
        "claims|count:class=primary-verifiable"
      ]
    },
    {
      "id": "coverage-claim-prose",
      "file": "artifacts/verification/coverage.json",
      "pattern": "(\\d+) deliberate mutations across (\\d+) gates, (\\d+) detected, (\\d+) survived",
      "artifact": "artifacts/verification/mutation_report.json",
      "select": [
        "total_mutations",
        "by_gate|len",
        "detected",
        "survived"
      ]
    },
    {
      "id": "onepager-mutations",
      "file": "outbound/ONE_PAGER.md",
      "pattern": "(\\d+) deliberate mutations, (\\d+) detected, (\\d+) survived",
      "artifact": "artifacts/verification/mutation_report.json",
      "select": [
        "total_mutations",
        "detected",
        "survived"
      ]
    },
    {
      "id": "onepager-weakest-row",
      "file": "outbound/ONE_PAGER.md",
      "pattern": "\\*\\*(\\d+) of (\\d+) claims are in the weakest class\\*\\*",
      "artifact": "artifacts/verification/coverage.json",
      "select": [
        "claims|count:class=neither",
        "claims|len"
      ]
    },
    {
      "id": "diligence-mutations",
      "file": "docs/DILIGENCE.md",
      "pattern": "(\\d+) mutations across (\\d+) gates certify every gate can fail",
      "artifact": "artifacts/verification/mutation_report.json",
      "select": [
        "total_mutations",
        "by_gate|len"
      ]
    },
    {
      "id": "brief-mutations",
      "file": "outbound/EVIDENCE_BRIEF.md",
      "pattern": "\\*\\*(\\d+)\\*\\* deliberate mutations across \\*\\*(\\d+)\\*\\* gates, \\*\\*(\\d+)\\*\\* detected, \\*\\*(\\d+)\\*\\* survived",
      "artifact": "artifacts/verification/mutation_report.json",
      "select": [
        "total_mutations",
        "by_gate|len",
        "detected",
        "survived"
      ]
    },
    {
      "id": "narrative-mutations-short",
      "file": "outbound/NARRATIVE.md",
      "pattern": "(\\d+) deliberate mutations, (\\d+) detected, (\\d+) survived",
      "artifact": "artifacts/verification/mutation_report.json",
      "select": [
        "total_mutations",
        "detected",
        "survived"
      ]
    },
    {
      "id": "narrative-mutations-gates",
      "file": "outbound/NARRATIVE.md",
      "pattern": "(\\d+) deliberate mutations across (\\d+) gates, (\\d+) detected, (\\d+) survived",
      "artifact": "artifacts/verification/mutation_report.json",
      "select": [
        "total_mutations",
        "by_gate|len",
        "detected",
        "survived"
      ]
    },
    {
      "id": "readme-headline-interval",
      "file": "README.md",
      "pattern": "cluster-corrected 95% interval of \\*\\*\\[([0-9.]+), ([0-9.]+)\\]\\*\\*",
      "artifact": "artifacts/pivot/deflate_curve.json",
      "select": [
        "slope_ci95_low",
        "slope_ci95_high"
      ]
    },
    {
      "id": "verdict-summary-interval",
      "file": "VERDICT.md",
      "pattern": "cluster-corrected 95% CI \\[([0-9.]+), ([0-9.]+)\\], over 2.9031 decades",
      "artifact": "artifacts/pivot/deflate_curve.json",
      "select": [
        "slope_ci95_low",
        "slope_ci95_high"
      ]
    },
    {
      "id": "verdict-clause-lower-bound",
      "file": "VERDICT.md",
      "pattern": "\\| Slope 95% lower bound \\(cluster bootstrap\\) \\| > 0 \\| ([0-9.]+) \\| pass \\|",
      "artifact": "artifacts/pivot/deflate_curve.json",
      "select": [
        "slope_ci95_low"
      ]
    },
    {
      "id": "verdict-2048-depth16-at-1024",
      "file": "VERDICT.md",
      "pattern": "\\*\\*0\\.1447\\*\\* at 2048 \\(it was \\*\\*([0-9.]+)\\*\\* at 1024",
      "artifact": "artifacts/pivot/carve_generalisation.json",
      "select": [
        "within_trivial_baselines.depth16_tree"
      ]
    },
    {
      "id": "narrative-prereg-count",
      "file": "outbound/NARRATIVE.md",
      "pattern": "(\\d+) preregistrations,\\n> hash-chained",
      "artifact": "artifacts/verification/prereg_status.json",
      "select": [
        "chain|len"
      ]
    },
    {
      "id": "narrative-corrections-ledger",
      "file": "outbound/NARRATIVE.md",
      "pattern": "corrections ledger now carries (\\d+) entries",
      "artifact": "artifacts/verification/record_counts.json",
      "select": [
        "corrections_entries"
      ]
    },
    {
      "id": "narrative-corrections-answer",
      "file": "outbound/NARRATIVE.md",
      "pattern": "> (\\d+) corrections at full size",
      "artifact": "artifacts/verification/record_counts.json",
      "select": [
        "corrections_entries"
      ]
    },
    {
      "id": "brief-prereg-count",
      "file": "outbound/EVIDENCE_BRIEF.md",
      "pattern": "\\*\\*(\\d+)\\*\\* preregistrations, hash-chained",
      "artifact": "artifacts/verification/prereg_status.json",
      "select": [
        "chain|len"
      ]
    },
    {
      "id": "brief-corrections-count",
      "file": "outbound/EVIDENCE_BRIEF.md",
      "pattern": "\\*\\*(\\d+)\\*\\* corrections filed against this work",
      "artifact": "artifacts/verification/record_counts.json",
      "select": [
        "corrections_entries"
      ]
    },
    {
      "id": "diligence-corrections-count",
      "file": "docs/DILIGENCE.md",
      "pattern": "`CORRECTIONS.md`: (\\d+) entries at full size",
      "artifact": "artifacts/verification/record_counts.json",
      "select": [
        "corrections_entries"
      ]
    }
  ]
}
