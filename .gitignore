.venv/
__pycache__/
*.pyc
data/raw/
data/work/
*.egg-info/
.DS_Store

# Bulk corpora pulled for a single experiment do not belong in git. data/asmprov/ is a
# deliberate exception, kept because the inputs to a load-bearing measurement survived there;
# see data/asmprov/README.md.
data/*/*.zip
data/*/*.tar*

# Pivot working data: the source corpus is re-fetched by tools/pivot/fetch_sources.sh and the
# feature caches are regenerated by tools/pivot/run_study.py. Neither belongs in git.
data/pivot/
